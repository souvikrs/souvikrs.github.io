---
import ProfileLinks from "../components/ProfileLinks.astro";
import manuscripts from "../data/books.json";
import books from "../data/published-books.json";
import Layout from "../layouts/Layout.astro";
import "../interior.css";
import "../author.css";

const featured = books.find((book) => book.asin === "B0DSSTZZ59")!;
const shelves = [
  ["original", "Books I wrote"],
  ["translation", "Books I translated"],
];
---

<Layout
  title="Author, poet & lyricist"
  description="Read Souvik Ghosh’s Bengali poems and articles, explore his books and translations, and see what’s on his writing desk."
>
  <article class="folio writing" id="writing">
    <header class="reader-intro">
      <div class="profile-opening">
        <div class="opening-copy">
          <span class="stamp">Souvik Ghosh / Writing</span>
          <h1>Author, poet &amp; lyricist</h1>
          <p class="intro">
            Kolkata is where my fictional detectives look for clues and where a
            virologist in one of my novels first encounters a pathogen that
            learns. In Bengali verse, I can stay with a single thought for a
            whole poem.
          </p>
          <div class="profile-actions">
            <a class="profile-button" href="#books">
              Browse the bookshelf
            </a>
            <a href="#reading">Shorter reads ↓</a>
          </div>
        </div>
        <a
          class="jacket-feature"
          href={`https://www.amazon.in/dp/${featured.asin}`}
        >
          <img
            src={`/images/books/${featured.asin}.webp`}
            alt={`Cover of ${featured.title}`}
            width={featured.width}
            height="720"
          />
          <span>
            <span class="folio-meta">Featured fiction</span>
            <strong>{featured.title}</strong>
            <span class="jacket-link">Explore the novel on Kindle →</span>
          </span>
        </a>
      </div>
      <nav class="reader-paths" aria-label="Choose what to read">
        <a id="poetry" href="https://www.facebook.com/souvikghoshrs">
          <span class="folio-meta">01 / Poetry</span>
          <strong lang="bn">বাংলা কবিতা</strong>
          <span>Read my poems on Facebook ↗︎</span>
        </a>
        <a id="essays" href="https://souvikghoshrs.substack.com/">
          <span class="folio-meta">02 / Articles</span>
          <strong>Essays &amp; articles</strong>
          <span>Read my Substack ↗︎</span>
        </a>
        <a href="#books">
          <span class="folio-meta">03 / Books</span>
          <strong>The bookshelf</strong>
          <span>Browse my books ↓</span>
        </a>
      </nav>
    </header>

    <section id="books" class="bookcase" aria-labelledby="books-heading">
      <div class="bookcase-title">
        <span class="folio-meta">Published work</span>
        <h2 id="books-heading">The bookshelf</h2>
      </div>
      {shelves.map(([key, title]) => (
        <section class="book-shelf" aria-labelledby={key}>
          <h3 id={key}>{title}</h3>
          <div class="book-grid">
            {books
              .filter((b) => b.shelf === key)
              .map((b) => (
                <a class="book" href={`https://www.amazon.in/dp/${b.asin}`}>
                  <div class="cover-frame">
                    <img
                      src={`/images/books/${b.asin}.webp`}
                      alt={`Cover of ${b.title}`}
                      width={b.width}
                      height="720"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <h4>{b.title}</h4>
                  {b.subtitle && <p class="book-subtitle">{b.subtitle}</p>}
                  <p class="book-hook">{b.hook}</p>
                  <p class="book-credit">{b.credit}</p>
                  <span class="book-link">
                    View on Amazon India <span aria-hidden="true">↗︎</span>
                  </span>
                </a>
              ))}
          </div>
        </section>
      ))}
    </section>

    <section class="folio-row" id="manuscripts">
      <div>
        <span class="stamp">Work in progress</span>
        <h2>On my writing desk</h2>
      </div>
      <div>
        {manuscripts.map((b) => (
          <article
            class="venture"
            id={b.shelf === "Detective fiction" ? "fiction" : undefined}
          >
            <span class="folio-meta">
              {b.form} · {b.status}
            </span>
            <h3 lang={b.language}>{b.title}</h3>
            <p>{b.description}</p>
          </article>
        ))}
      </div>
    </section>
    <section class="folio-row" id="reading">
      <div>
        <span class="stamp">Poems, lyrics &amp; essays</span>
        <h2>If you have a few minutes</h2>
      </div>
      <div>
        <h3 lang="bn">বাংলা কবিতা</h3>
        <p>
          I write poems and lyrics, and I also work in the two-line form of the
          Hindi doha. I share my Bengali poems on{" "}
          <a href="https://www.facebook.com/souvikghoshrs">
            my personal Facebook page
          </a>
          .
        </p>
        <h3>From the lab to the public page</h3>
        <p>
          What happens when the policy moves faster than the hardware? That is
          the question behind{" "}
          <a href="https://souvikghoshrs.substack.com/p/before-the-qubits-are-ready-the-policy">
            Before the Qubits Are Ready, the Policy Has Arrived
          </a>
          . You can read and subscribe to my articles on{" "}
          <a href="https://souvikghoshrs.substack.com/">Substack</a>.
        </p>
        <h3 id="talks">Writing for Master Within</h3>
        <p>
          In{" "}
          <a href="https://masterwithin.substack.com/p/what-does-not-move">
            What Does Not Move
          </a>
          , I ask how to choose when the same act can help one person and harm
          another.
        </p>
        <a href="/speaker/">Hear my talks and classes →</a>
      </div>
    </section>
    <ProfileLinks related={["speaker", "spiritual-mentor"]} />
  </article>
</Layout>
