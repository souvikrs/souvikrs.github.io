---
import Layout from "../layouts/Layout.astro";
import "../interior.css";
---

<Layout title="Contact">
  <article class="folio contact">
    <header>
      <span class="stamp">Correspondence</span>
      <h1>Write to me.</h1>
      <p class="intro">
        If something here overlaps with your own work, I’d like to hear about
        it.
      </p>
    </header>
    <section class="folio-row" id="email">
      <h2>Email</h2>
      <div>
        <h3>Personal, research &amp; writing</h3>
        <a class="contact-address" href="mailto:souvikghosh2012@gmail.com">
          souvikghosh2012@gmail.com
        </a>
        <h3 class="contact-next">Vishwa Vigyan &amp; project enquiries</h3>
        <a class="contact-address" href="mailto:founder@vishwavigyan.com">
          founder@vishwavigyan.com
        </a>
      </div>
    </section>
    <section class="folio-row" id="newsletter">
      <h2>SouvikOS Letters</h2>
      <div>
        <p>
          My personal newsletter hasn’t opened for subscriptions yet. You can
          already read my published work and see what’s on my writing desk.
        </p>
        <a href="https://souvikghoshrs.substack.com/">
          Read my articles on Substack ↗
        </a>
      </div>
    </section>
  </article>
</Layout>
