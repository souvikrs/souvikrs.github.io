---
import Layout from "./Layout.astro";
import ProfileLinks from "../components/ProfileLinks.astro";
import { profileFor, type ProfileSlug } from "../data/profiles";
import "../interior.css";
interface Props {
  slug: ProfileSlug;
  related: ProfileSlug[];
}
const { slug, related } = Astro.props;
const role = profileFor(slug);
---

<Layout title={role.label} description={role.description}>
  <article class="folio" style={`--accent:var(--${role.color})`}>
    <header class="profile-opening">
      <div class="opening-copy">
        <span class="stamp">Souvik Ghosh / {role.category}</span>
        <h1>{role.label}</h1>
        <p class="intro">
          <slot name="intro" />
        </p>
        <slot name="lead" />
      </div>
      <slot name="plate" />
    </header>
    <slot />
    <ProfileLinks related={related} />
  </article>
</Layout>
