---
import Mark from "../components/Mark.astro";
import "../fonts.css";
import "../global.css";
const {
  title,
  description = "The work of Souvik Ghosh across physics, invention, writing, business and spiritual mentorship.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const links = [
  ["About", "/about/"],
  ["Profiles", "/#profiles"],
  ["Research", "/quantum-physicist/"],
  ["Writing", "/author/"],
  ["Contact", "/contact/"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SouvikOS" />
    <meta
      property="og:image"
      content={new URL("/images/souvik-portrait.webp", Astro.site).href}
    />
    <meta
      property="og:image:alt"
      content="Souvik Ghosh smiling in a white shirt"
    />
    <meta property="og:title" content={title + " · Souvik Ghosh"} />
    <meta property="og:description" content={description} />
    <title>{title} · Souvik Ghosh</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="mast wrap">
      <a class="brand" href="/">
        <Mark />
      </a>
      <nav aria-label="Main navigation">
        {links.map(([label, url]) => (
          <a
            href={url}
            aria-current={Astro.url.pathname === url ? "page" : undefined}
          >
            {label}
          </a>
        ))}
      </nav>
    </header>
    <main class="wrap" id="main">
      <slot />
    </main>
    <footer class="wrap">
      <a class="brand" href="/">
        <Mark />
      </a>
      <div class="footer-emails">
        <a href="mailto:souvikghosh2012@gmail.com">souvikghosh2012@gmail.com</a>
        <a href="mailto:founder@vishwavigyan.com">founder@vishwavigyan.com</a>
      </div>
    </footer>
  </body>
</html>
